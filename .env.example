# Copy to .env and fill in. Never commit .env.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Database ---
DATABASE_URL=

# --- Claude ---
ANTHROPIC_API_KEY=

# --- Voice (Vapi) ---
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# --- App ---
MCP_API_KEY=
APP_PASSCODE=
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true
