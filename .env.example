# Copy to .env and fill in. Never commit .env.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Database ---
# Local: docker run -d --name allowance-pg -e POSTGRES_USER=allowance -e POSTGRES_PASSWORD=allowance -e POSTGRES_DB=allowance -p 5433:5432 postgres:17-alpine
DATABASE_URL=postgres://allowance:allowance@localhost:5433/allowance
# Integration tests (create it: docker exec allowance-pg psql -U allowance -c 'CREATE DATABASE allowance_test')
TEST_DATABASE_URL=postgres://allowance:allowance@localhost:5433/allowance_test

# --- Claude ---
ANTHROPIC_API_KEY=
# Shopping agent model (default claude-haiku-5-5). Use claude-sonnet-5-5 if it misbehaves on camera.
AGENT_MODEL=

# --- Voice (Vapi) ---
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# --- App ---
# Bearer key for /api/mcp (any long random string, e.g. `openssl rand -hex 24`). Unset = MCP disabled.
MCP_API_KEY=
# Dashboard passcode. Unset = dashboard open (local dev only). Cookies are signed with SESSION_SECRET (falls back to the passcode).
APP_PASSCODE=
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000
DEMO_MODE=true

# Vaulted buyer for demo reset on a server without .spike-state.json (Render)
PAYPAL_DEMO_VAULT_ID=
PAYPAL_DEMO_PAYER_EMAIL=
